# Kopyahin ito sa .env at i-export ang mga value bago patakbuhin sa production.
# Sa development, hindi ito kailangan: may mga default na.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=palitan-ng-mahabang-random-na-string
DJANGO_ALLOWED_HOSTS=lostfound.example.edu.ph
CORS_ALLOWED_ORIGINS=https://lostfound.example.edu.ph
CSRF_TRUSTED_ORIGINS=https://lostfound.example.edu.ph
