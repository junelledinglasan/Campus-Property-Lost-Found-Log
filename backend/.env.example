# Kopyahin ito sa .env at i-export ang mga value bago patakbuhin sa production.
# Sa development, hindi ito kailangan: may mga default na.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=palitan-ng-mahabang-random-na-string
DJANGO_ALLOWED_HOSTS=lostfound.example.edu.ph
CORS_ALLOWED_ORIGINS=https://lostfound.example.edu.ph
CSRF_TRUSTED_ORIGINS=https://lostfound.example.edu.ph

# Database. Kapag walang DATABASE_URL, SQLite ang gagamitin.
# Supabase: Connect > Session pooler (port 5432), at idagdag ang ?sslmode=require
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Storage (S3). Kapag walang SUPABASE_S3_ACCESS_KEY, sa disk ise-save ang mga larawan.
SUPABASE_PROJECT_REF=abcdefghijklmnop
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_BUCKET_ITEMS=lf-items
SUPABASE_BUCKET_HANDOVER=lf-handover

# Unang OSAS account (ginagawa ng `python manage.py ensure_admin`; hindi na babaguhin kapag umiiral na)
OSAS_USERNAME=osas
OSAS_PASSWORD=palitan-ng-matibay-na-password

# 1 kapag nasa likod ng isang proxy (Render), para tamang IP ang binibilang ng throttle
DRF_NUM_PROXIES=1
